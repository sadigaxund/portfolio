---
import { nextSibling, ROOT, type TreeNode } from "../tree/walk";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
const next = nextSibling(node);
const parent = node.parent ?? ROOT;
---

<nav class="leaf-foot" aria-label="More">
  {
    next && (
      <a class="leaf-foot-next" href={next.url}>
        <span class="role-detail">Next</span>{" "}
        <span class="role-item">{next.label}</span>
      </a>
    )
  }
  <a class="leaf-foot-back" href={parent.url}>
    <span class="role-detail">Back to</span>{" "}
    <span class="role-item">{parent === ROOT ? "Start" : parent.label}</span>
  </a>
</nav>
