---
import SiteFoot from "../discovery/SiteFoot.astro";
import Note from "../markii/Note.astro";
import type { TreeNode } from "../tree/walk";
import LeafFoot from "./LeafFoot.astro";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
---

<main id="content" class="leaf-surface">
  <div class="leaf-head"></div>
  <div class="leaf-column">
    <Note node={node} />
    <LeafFoot node={node} />
  </div>
</main>
<SiteFoot />
