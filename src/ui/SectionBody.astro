---
import { Link } from "my-you-eye";
import { EMPTY_SECTION, previewOf, summaryOf } from "../sections/previews";
import { LOCAL_IMAGES } from "../markii/localImages";
import { thumbUrl } from "../sections/thumbs";
import { isLeaf, type TreeNode } from "../tree/walk";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
---

<main id="content" class="line-section">
  <div class="line-content">
    <h1 class="role-heading">{node.label}</h1>
    {summaryOf(node) && <p class="role-lead">{summaryOf(node)}</p>}
    {node.children.length === 0 && <p class="role-detail">{EMPTY_SECTION}</p>}
  </div>
  <ol class="stops">
    {
      node.children.map((child, index) => (
        <li
          class="stop"
          data-stop-url={child.url}
          data-side={index % 2 === 0 ? "end" : "start"}
          data-kind={isLeaf(child) ? "leaf" : "section"}
          style={`--stop-index: ${index}`}
        >
          <span class="stop-branch" aria-hidden="true" />
          <div class="stop-text">
            {/* Decorative: the title beside it names the project, so the alt is empty. */}
            {child.thumb && <img class="stop-thumb" src={thumbUrl(child.thumb, LOCAL_IMAGES)} alt="" width="480" height="300" loading="lazy" decoding="async" />}
            <h2 class="role-item">
              <Link href={child.url}>{child.label}</Link>
            </h2>
            {(child.stars || previewOf(child)) && (
              <p class="role-detail">
                {child.stars && (
                  <span class="stop-stars">
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1.2l1.95 4.1 4.5.55-3.3 3.1.85 4.45L8 11.2l-4 2.2.85-4.45-3.3-3.1 4.5-.55z" /></svg>
                    {child.stars} stars.
                  </span>
                )}{" "}
                {previewOf(child)}
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</main>
