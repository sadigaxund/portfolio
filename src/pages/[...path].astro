---
import LineLayout from "../layouts/LineLayout.astro";
import { ALL_NODES, nodeAt } from "../tree/walk";

export function getStaticPaths() {
  return ALL_NODES.map((node) => ({ params: { path: node.url === "/" ? undefined : node.url.slice(1) } }));
}

const node = nodeAt(Astro.url.pathname);
if (!node) throw new Error(`No tree node for ${Astro.url.pathname}`);
---

<LineLayout node={node} />
