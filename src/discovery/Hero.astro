---
import { Link } from "my-you-eye";
import { PROFILE } from "./profile";

interface Props {
  name: string;
}

const { name } = Astro.props;
---

<header class="hero">
  <div class="hero-who">
    <h1 class="role-name">{name}</h1>
    <p class="role-detail">{PROFILE.role}</p>
  </div>
  <div class="hero-what">
    <p class="role-body">{PROFILE.summary}</p>
    <ul class="hero-links">
    {
      PROFILE.links.map((link) => (
        <li>
          <Link href={link.href}>{link.label}</Link>
        </li>
      ))
    }
    </ul>
  </div>
</header>
