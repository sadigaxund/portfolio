---
import { ClientRouter } from "astro:transitions";
import { Link } from "my-you-eye";
import "./styles";
import Hero from "../discovery/Hero.astro";
import LineStage from "../line/LineStage";
import DefaultLeaf from "../sections/DefaultLeaf.astro";
import { isLeaf, routeParam, type TreeNode } from "../tree/walk";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
const atRoot = node.parent === null;
const leaf = isLeaf(node);

// A leaf's folder mirrors its route. A leaf with no folder gets the default.
const LEAVES = import.meta.glob<{ default: typeof DefaultLeaf }>("../sections/**/Leaf.astro", { eager: true });
const Leaf = LEAVES[`../sections/${routeParam(node)}/Leaf.astro`]?.default ?? DefaultLeaf;
---

<!doctype html>
<html lang="en" transition:animate="none" data-view={leaf ? "leaf" : "line"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{node.label}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <ClientRouter />
  </head>
  <body>
    <LineStage client:load transition:persist="line" transition:persist-props initialPath={node.url} />
    {
      leaf ? (
        <main class="leaf-surface">
          <Leaf node={node} />
        </main>
      ) : (
        <main class={atRoot ? "line-section line-landing" : "line-section"}>
          {atRoot ? (
            <Hero name={node.label} />
          ) : (
            <div class="line-content">
              <h1 class="role-heading">{node.label}</h1>
              <p class="role-body">PLACEHOLDER</p>
            </div>
          )}
          {!atRoot && (
            <ol class="stops">
              {node.children.map((child, index) => (
                <li
                  class="stop"
                  data-stop-url={child.url}
                  data-side={index % 2 === 0 ? "end" : "start"}
                  data-kind={isLeaf(child) ? "leaf" : "section"}
                  style={`--stop-index: ${index}`}
                >
                  <span class="stop-branch" aria-hidden="true" />
                  <Link href={child.url}>{child.label}</Link>
                </li>
              ))}
            </ol>
          )}
        </main>
      )
    }
  </body>
</html>

<script>
  // ?debug=line turns on the frame meter, and sessionStorage keeps it on across pages.
  const wanted = new URLSearchParams(location.search).get("debug") === "line";
  try {
    if (wanted) sessionStorage.setItem("line-debug", "1");
    if (wanted || sessionStorage.getItem("line-debug") === "1") void import("../line/debug");
  } catch {
    if (wanted) void import("../line/debug");
  }
</script>
