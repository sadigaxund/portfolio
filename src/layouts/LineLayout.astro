---
import { ClientRouter } from "astro:transitions";
import geologica from "@fontsource-variable/geologica/files/geologica-latin-wght-normal.woff2?url";
import instrumentSans from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "./styles";
import Hero from "../discovery/Hero.astro";
import { PROFILE } from "../discovery/profile";
import LineStage from "../line/LineStage";
import { summaryOf } from "../sections/previews";
import { isLeaf, ROOT, type TreeNode } from "../tree/walk";
import LeafBody from "../ui/LeafBody.astro";
import SectionBody from "../ui/SectionBody.astro";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
const atRoot = node.parent === null;
const leaf = isLeaf(node);
const shareTitle = atRoot ? node.label : `${node.label}, ${ROOT.label}`;
const description = summaryOf(node) ?? node.preview ?? PROFILE.summary;
const canonical = Astro.site ? new URL(node.url, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" transition:animate="none" data-view={leaf ? "leaf" : "line"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{node.label}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    <link rel="preload" as="font" type="font/woff2" href={geologica} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={instrumentSans} crossorigin />
    <script is:inline>
      // ?coat=grid|contour|transit previews a coating, and sessionStorage keeps it for the tab. ?coat=none clears it.
      (() => {
        const apply = () => {
          try {
            const coat = sessionStorage.getItem("coat");
            if (coat) document.documentElement.dataset.coat = coat;
            else delete document.documentElement.dataset.coat;
          } catch {
            // Blocked storage leaves the coat off.
          }
        };
        try {
          const asked = new URLSearchParams(location.search).get("coat");
          if (asked === "" || asked === "none") sessionStorage.removeItem("coat");
          else if (["grid", "contour", "transit"].includes(asked)) sessionStorage.setItem("coat", asked);
        } catch {
          // Blocked storage leaves the coat off.
        }
        apply();
        // A route change swaps the root's attributes, so the coat is put back after each swap.
        if (!window.coatSwap) document.addEventListener("astro:after-swap", apply);
        window.coatSwap = true;
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    {
      atRoot ? (
        <>
          {/* The hero comes first, so keyboard and screen reader order matches what a visitor sees. */}
          <main id="content" class="line-section line-landing">
            <Hero name={node.label} />
          </main>
          <LineStage client:load transition:persist="line" transition:persist-props initialPath={node.url} />
        </>
      ) : (
        <>
          <a class="skip-link" href="#content">Skip to content</a>
          <LineStage client:load transition:persist="line" transition:persist-props initialPath={node.url} />
          {leaf ? <LeafBody node={node} /> : <SectionBody node={node} />}
        </>
      )
    }
  </body>
</html>

<script>
  // ?debug=line turns on the frame meter, and sessionStorage keeps it on across pages.
  const wanted = new URLSearchParams(location.search).get("debug") === "line";
  try {
    if (wanted) sessionStorage.setItem("line-debug", "1");
    if (wanted || sessionStorage.getItem("line-debug") === "1") void import("../line/debug");
  } catch {
    if (wanted) void import("../line/debug");
  }
</script>
