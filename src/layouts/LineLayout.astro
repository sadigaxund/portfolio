---
import { ClientRouter } from "astro:transitions";
import { Link } from "my-you-eye";
import "../styles/global.css";
import "../styles/line.css";
import LineStage from "../line/LineStage";
import type { TreeNode } from "../tree/walk";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
const atRoot = node.parent === null;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{node.label}</title>
    <ClientRouter />
  </head>
  <body>
    <LineStage client:load transition:persist="line" transition:persist-props initialPath={node.url} />
    <main class="line-content" data-at-root={atRoot}>
      <h1>{node.label}</h1>
      <p>PLACEHOLDER</p>
      {
        !atRoot && node.children.length > 0 && (
          <ul>
            {node.children.map((child) => (
              <li>
                <Link href={child.url}>{child.label}</Link>
              </li>
            ))}
          </ul>
        )
      }
      {!atRoot && <div style="height: 120vh" />}
      {!atRoot && <p>PLACEHOLDER end of page</p>}
    </main>
  </body>
</html>

<script>
  // ?debug=line turns on the frame meter, and sessionStorage keeps it on across pages.
  const wanted = new URLSearchParams(location.search).get("debug") === "line";
  try {
    if (wanted) sessionStorage.setItem("line-debug", "1");
    if (wanted || sessionStorage.getItem("line-debug") === "1") void import("../line/debug");
  } catch {
    if (wanted) void import("../line/debug");
  }
</script>
