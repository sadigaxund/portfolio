---
import { ALL_NODES, isLeaf, routeParam, type TreeNode } from "../tree/walk";
import NoteBody from "./NoteBody";
import NoteIsland from "./NoteIsland";
import NoteIslandPacks from "./NoteIslandPacks";
import NotePacks from "./NotePacks.astro";
import { BUNDLED } from "./bundled";
import { PACKS } from "./packRegistry";
import { bakeNote } from "./bake";
import { packNamespacesUsed } from "./registry";
import { SETTINGS } from "./config";
import { noteHasScripts, staleValuesForRehydration } from "@markii/host";
import { pagerMarkdown } from "./pager";
import { fetchRemoteNote, parseRemoteNote } from "../notes/remote";

interface Props {
  node: TreeNode;
}

const { node } = Astro.props;
// Notes are read at build time. The build check has already matched each leaf to one note.
const LOCAL = import.meta.glob<string>("/content/**/*.{md,mk.md}", { query: "?raw", import: "default", eager: true });
const REMOTE = import.meta.glob<unknown>("/content/**/*.remote.yaml", { import: "default", eager: true });
const route = routeParam(node);
const stem = (key: string) => key.replace(/\.(mk\.md|md|remote\.yaml)$/, "");
const path = [...Object.keys(LOCAL), ...Object.keys(REMOTE)].find((key) => stem(key) === `/content/${route}`);
if (path === undefined) throw new Error(`No note for ${node.url}`);
const documentKey = path.slice(1);
const remote = path in REMOTE ? parseRemoteNote(documentKey, REMOTE[path]) : undefined;
// The pager joins the note text here, so the static HTML, the pack scan and the island all see it.
const text = (remote ? await fetchRemoteNote(documentKey, remote) : LOCAL[path]) + pagerMarkdown(node);
const routes = Object.fromEntries(ALL_NODES.filter(isLeaf).map((leaf) => [`content/${routeParam(leaf)}`, leaf.url]));
const scripted = noteHasScripts(text);
const packNames = packNamespacesUsed(BUNDLED, text);
const usesPacks = packNames.length > 0;
const baked = scripted
  ? staleValuesForRehydration(await bakeNote({ documentKey, text, allowedOrigins: SETTINGS.allowedOrigins, log: (line) => console.warn(line) }))
  : {};
const builtLabel = new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(new Date());
---

<NotePacks names={packNames} />
{
  scripted && usesPacks ? (
    <NoteIslandPacks client:idle text={text} documentKey={documentKey} routes={routes} remote={remote} bakedStale={baked} builtLabel={builtLabel} />
  ) : scripted ? (
    <NoteIsland client:idle text={text} documentKey={documentKey} routes={routes} remote={remote} bakedStale={baked} builtLabel={builtLabel} />
  ) : (
    <NoteBody text={text} documentKey={documentKey} routes={routes} remote={remote} registry={PACKS.registry} />
  )
}
